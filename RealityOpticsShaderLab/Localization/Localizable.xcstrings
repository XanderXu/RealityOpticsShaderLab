    "effect.absorbingGlass.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A finite slab path uses RGB Beer-Lambert absorption and Fresnel surface reflection. The background is a prepared environment, not a refraction of the real camera image; thickness is controlled by a parameter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限平板光程与 RGB Beer–Lambert 吸收，叠加 Fresnel 表面反射；背景为预制环境，非现实透视画面的折射，厚度由参数指定"
          }
        }
      }
    },
    "effect.absorbingGlass.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorbing Glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吸收玻璃"
          }
        }
      }
    },
    "effect.absorbingGlass.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thickness and viewing angle change the transmitted glass color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "厚度与观察角度共同改变玻璃透射色"
          }
        }
      }
    },
    "effect.absorbingGlass.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colored Absorbing Glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吸收玻璃"
          }
        }
      }
    },
    "effect.alexandrite.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Representative linear RGB endpoints for two reference illuminants mix with Beer-Lambert RGB absorption. This is a light-source color-change illustration, not a measured alexandrite spectrum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种参考照明下的代表性线性 RGB 端点混合，并用 Beer–Lambert RGB 透过率控制深浅；是光源变色示意，非实测变石光谱"
          }
        }
      }
    },
    "effect.alexandrite.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变石效应"
          }
        }
      }
    },
    "effect.alexandrite.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green body color changes toward red-purple under warm light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换照明色谱，绿色体色转为红紫色"
          }
        }
      }
    },
    "effect.alexandrite.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrite Color Change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变石效应"
          }
        }
      }
    },
    "effect.atmosphere.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An analytic path through a spherical shell and a spectral single-scattering Rayleigh LUT respond to sun direction and approximate sunset attenuation. The glow is shown on the surface, without a real external volume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析球壳视线长度与光谱 Rayleigh 单次散射 LUT，结合太阳方向和近似日落衰减；在模型表面显示，不生成真实外部大气体积"
          }
        }
      }
    },
    "effect.atmosphere.menuTitle": {
      "localizations": {
        "en": {
