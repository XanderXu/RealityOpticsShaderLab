      }
    },
    "effect.birefringence.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A procedural stress field approximates phase delay. Spectral transmission uses sin²(δ·550/2λ) and an axis extinction factor; the white-light phase LUT stays continuous rather than wrapping at 2π."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序化应力场近似相位延迟，光谱透过率 sin²(δ·550/2λ) 乘轴向消光因子；白光相位连续查表，不按 2π 重复"
          }
        }
      }
    },
    "effect.birefringence.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birefringence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双折射"
          }
        }
      }
    },
    "effect.birefringence.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stress stripes and dark areas appear between crossed polarizers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正交偏振片下，应力塑料和尺子上的彩色条纹与消光区域"
          }
        }
      }
    },
    "effect.birefringence.title": {
      "localizations": {
