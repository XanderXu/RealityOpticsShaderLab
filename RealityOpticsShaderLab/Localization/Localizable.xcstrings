    "effect.chameleon.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crystal spacing shifts the skin's structural color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虹彩细胞内纳米晶体间距变化可改变结构色，本演示以晶域色彩循环近似"
          }
        }
      }
    },
    "effect.chameleon.title": {
