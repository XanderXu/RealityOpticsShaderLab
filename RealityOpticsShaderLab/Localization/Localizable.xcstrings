    "effect.beetle.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A green-band chitin film mixes with grating colors varying along mesh tangents; elliptical polarization is not calculated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几丁质绿带薄膜与沿网格切向变化的光栅色混合；不包含椭圆偏振计算"
          }
        }
      }
    },
    "effect.beetle.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beetle Shell"
