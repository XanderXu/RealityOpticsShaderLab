      }
    },
    "effect.dichroic.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex-amplitude recursion integrates a six-layer quarter-wave H/L stack. For its nonabsorbing stack, transmission uses T=1−R. The display channel switches without refracting the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六层高低折射率四分之一波膜的复振幅递推，光谱积分；透射使用无吸收堆栈的 T=1−R，显示通道可切换，不包含背景折射"
          }
        }
      }
    },
    "effect.dichroic.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichroic Glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二向色玻璃"
          }
        }
      }
    },
    "effect.dichroic.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multilayer filters reflect and transmit complementary colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多层滤光膜反射与透射的互补颜色"
          }
        }
      }
    },
    "effect.dichroic.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichroic Multilayer Glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二向色玻璃"
          }
        }
      }
    },
    "effect.dragonfly.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ultra-thin-film LUT combines with a triangular-wave vein grid, opaque veins and a translucent membrane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "薄膜 LUT（超薄偏置）+ 三角波抖动网格脉络（横脉×纵脉×边缘）+ 脉络不透明/翅膜半透明"
          }
        }
      }
    },
    "effect.dragonfly.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragonfly Wing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蜻蜓翅膀"
          }
        }
      }
    },
    "effect.dragonfly.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A faint rainbow sits over dark veins and a translucent wing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翅膜超薄薄膜干涉的微弱虹彩 + 深色脉络网格 + 半透明翅膜"
          }
        }
      }
    },
    "effect.dragonfly.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragonfly Wing Iridescence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蜻蜓翅膀（Dragonfly Wing）"
          }
        }
      }
    },
    "effect.feather.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equivalent chitin-film color, sinusoidal barbule stripes and cell-noise glints approximate feather nanostructure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等效几丁质薄膜色 + 正弦羽枝条纹 + cellnoise 闪点；真实羽毛纳米结构采用外观近似"
          }
        }
      }
    },
    "effect.feather.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iridescent Feather"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孔雀羽"
          }
        }
      }
    },
    "effect.feather.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film colors, directional highlights and glints combine on a feather."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多层膜 + 各向异性高光 + glitter 的组合结构色"
          }
        }
      }
    },
    "effect.feather.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iridescent Hummingbird and Peacock Feather"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蜂鸟/孔雀羽（Iridescent Feather）"
          }
        }
      }
    },
    "effect.gemFire.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed environment map, three refracted wavelength bands and one approximate internal reflection produce gemstone fire. Program normals suggest facets; this does not trace the real gem interior or camera background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以固定环境图、三波段折射和一次内部反射近似宝石火彩；切面由程序法线模拟，不追踪真实几何内部光路或现实背景"
          }
        }
      }
    },
    "effect.gemFire.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemstone Fire"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宝石火彩"
          }
        }
      }
    },
    "effect.gemFire.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colored facet flashes shift with the viewing angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切面中的彩色闪光随观察方向切换"
          }
        }
      }
    },
    "effect.gemFire.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemstone Dispersion and Fire"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宝石火彩"
          }
        }
      }
    },
    "effect.grating.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grating equation, Gaussian spectral bands and weighted orders use a lookup table. Light and view point outward; the radial diffraction term is (L+V)·P and incident cosine controls brightness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光栅方程与高斯谱带、多阶加权查表；L/V 均从表面向外，径向衍射量为 (L+V)·P，入射余弦控制亮度"
          }
        }
      }
    },
    "effect.grating.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffraction Grating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "衍射光栅"
          }
        }
      }
    },
    "effect.grating.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CDs and records show rainbow reflections highly sensitive to viewing angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CD/DVD 盘面、黑胶唱片的彩虹反光，对视角偏移极其敏感（已实现）"
          }
        }
      }
    },
    "effect.grating.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffraction Grating · CD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "衍射光栅 · CD 光盘（Diffraction Grating）"
          }
        }
      }
    },
    "effect.hologram.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grating LUT is reused: U phase combines surface coordinate, tangent-view slide and row offset; V fixes each row's diffraction density, while gaps modulate brightness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复用光栅 LUT：U 相位 = 表面坐标 + 视线·切向滑动 + 行偏移，V 锁定每行衍射密度，行间隙亮度调制"
          }
        }
      }
    },
    "effect.hologram.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow Hologram"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩虹全息"
          }
        }
      }
    },
    "effect.hologram.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow rows on security labels slide across with the viewing angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡/防伪标上随视角水平滑动的彩虹条纹，一行条纹对应一个衍射视角"
          }
        }
      }
    },
    "effect.hologram.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow Hologram"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩虹全息图（Rainbow Hologram）"
          }
        }
      }
    },
    "effect.labradorite.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D crystal domains modulate directional flashes. An equivalent chitin-film LUT approximates lamellar interference color, not real feldspar exsolution layers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三维晶域调制定向闪光，等效几丁质膜 LUT 近似层片干涉颜色；不模拟真实长石层片堆栈"
          }
        }
      }
    },
    "effect.labradorite.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labradorite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉长石"
          }
        }
      }
    },
    "effect.labradorite.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large blue and golden flashes emerge as a dark stone rotates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色石体转动时出现蓝金色大块晕彩"
          }
        }
      }
    },
    "effect.labradorite.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labradorite Labradorescence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉长石"
          }
        }
      }
    },
    "effect.lcd.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed cell-noise thresholds toggle pixels with voltage; |N·V|⁴ approximates off-axis purple-green leakage. No liquid-crystal director or Jones matrix is solved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定 cellnoise 像素阈值随电压启闭，|N·V|⁴ 模拟斜视与紫绿泄漏；不求解液晶指向矢或 Jones 矩阵"
          }
        }
      }
    },
    "effect.lcd.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD Twist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液晶旋光"
          }
        }
      }
    },
    "effect.lcd.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD pixels darken and tint when viewed obliquely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液晶屏黑场的旋光纹理、计算器屏幕斜看发灰发紫——旋光角随电压/视角变化"
          }
        }
      }
    },
    "effect.lcd.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twisted LCD Cell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液晶旋光/电控调光（LCD Twist Cell）"
          }
        }
      }
    },
    "effect.lensCoating.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interference through a single n=1.38 MgF₂ layer on n=1.52 glass suppresses green reflection near 100 nm. It is not a commercial broadband stack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气／折射率 1.38 单层 MgF₂／折射率 1.52 玻璃的干涉模型；近 100 nm 抑制绿光反射，不代表商业多层宽带配方"
          }
        }
      }
    },
    "effect.lensCoating.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens Coating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜头镀膜"
          }
        }
      }
    },
    "effect.lensCoating.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-reflection glass retains a faint purple-green sheen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低反射镀膜残余的紫绿光泽"
          }
        }
      }
    },
    "effect.lensCoating.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens Antireflection Coating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜头镀膜"
          }
        }
      }
    },
    "effect.lenticular.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The view slope in object space selects one of four atlas images. Lenticular stripes perturb the view index. Compute generates the atlas once; this is an image-selection approximation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体空间观察斜率选择四视图图集；柱镜条带扰动视图索引。图集由 Compute 一次生成，属于柱镜选图近似"
          }
        }
      }
    },
    "effect.lenticular.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenticular Views"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柱镜变图"
          }
        }
      }
    },
    "effect.lenticular.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four colorful images switch as you look from side to side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右观察时切换四幅彩色图案"
          }
        }
      }
    },
    "effect.lenticular.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenticular Image Switching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柱镜变图"
          }
        }
      }
    },
    "effect.moire.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phase difference of two gratings yields a low-frequency beat mapped to three color channels. An analytic low-pass avoids subpixel flicker; zero layer gap removes parallax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算两层光栅的相位差，保留低频拍频并映射到三色通道；以解析低通代替易闪烁的亚像素混叠，层距为零时视差消失"
          }
        }
      }
    },
    "effect.moire.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color Moiré"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩色莫尔纹"
          }
        }
      }
    },
    "effect.moire.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parallax moves colored waves between two patterned layers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双层条纹因视差产生移动的彩色波纹"
          }
        }
      }
    },
    "effect.moire.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color Moiré"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩色莫尔纹"
          }
        }
      }
    },
    "effect.moonstone.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-frequency 3D texture and a broad angular scattering lobe suggest adularescence; volumetric multiple scattering is not solved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低频三维纹理与宽角度散射瓣模拟月光效应；不是体积多重散射求解"
          }
        }
      }
    },
    "effect.moonstone.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonstone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月光石"
          }
        }
      }
    },
    "effect.moonstone.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue-white soft light drifts inside a milky gem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝白柔光在乳白石体内漂移"
          }
        }
      }
    },
    "effect.moonstone.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonstone Adularescence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月光石"
          }
        }
      }
    },
    "effect.morpho.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An equivalent chitin film with noisy thickness has a visible reflection peak near 449 nm for a 216 nm film. It does not solve the actual branched multilayer scales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几丁质等效薄膜 + 噪声膜厚扰动；216 nm 膜在约 449 nm 有可见反射峰，不求解真实树状多层结构"
          }
        }
      }
    },
    "effect.morpho.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morpho Wing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闪蝶翅膀"
          }
        }
      }
    },
    "effect.morpho.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright blue wing color changes with view angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翅鳞纳米结构产生鲜明蓝色，本演示用等效几丁质薄膜近似"
          }
        }
      }
    },
    "effect.morpho.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morpho Butterfly Structural Color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闪蝶翅膀（Morpho Butterfly）"
          }
        }
      }
    },
    "effect.nacre.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent film reflections at three thicknesses are averaged, with thickness variance and reduced saturation. This approximates pearlescence rather than a coherent multilayer stack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三种厚度的独立薄膜反射取平均，增加膜厚方差并降饱和；属于珠光外观近似，不求解相干多层堆栈"
          }
        }
      }
    },
    "effect.nacre.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "珍珠母"
          }
        }
      }
    },
    "effect.nacre.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shells and pearls show softer, less saturated colors than bubbles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贝壳内壁、珍珠的柔和变色，比肥皂泡更低饱和更柔和"
          }
        }
      }
    },
    "effect.nacre.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacre and Pearlescence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "珍珠母/珠光（Nacre, Pearlescence）"
          }
        }
      }
    },
    "effect.newton.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated glass-air-glass Fresnel/Airy LUT uses a gap increasing as r². The external angle is first refracted with Snell's law; opacity clips the disc edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专用玻璃—空气—玻璃 Fresnel/Airy LUT，空气隙厚度按 r² 增长；外部视角先经 Snell 折射，圆盘边缘以透明度裁切"
          }
        }
      }
    },
    "effect.newton.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newton's Rings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牛顿环"
          }
        }
      }
    },
    "effect.newton.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentric colors arise in the gap between a lens and glass plate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平凸透镜贴平板玻璃的同心彩色圆环，空气隙厚度随半径平方变化"
          }
        }
      }
    },
    "effect.newton.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newton's Rings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牛顿环/等厚干涉（Newton's Rings）"
          }
        }
      }
    },
    "effect.oilFilm.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spectral three-medium stack uses air, n=1.47 oil and n=1.333 water. Texture varies local thickness, without fluid simulation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气／折射率 1.47 油膜／折射率 1.333 水的三介质光谱干涉；纹理改变局部膜厚，不模拟流体"
          }
        }
      }
    },
    "effect.oilFilm.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oil Film"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "油膜"
          }
        }
      }
    },
    "effect.oilFilm.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow-like color bands appear across a surface oil film."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水面油膜呈现流纹状干涉色"
          }
        }
      }
    },
    "effect.oilFilm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oil Film on Water"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "油膜"
          }
        }
      }
    },
    "effect.opal.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 2D Worley distance field perturbs grating-LUT coordinates to suggest patches; it does not solve a 3D photonic crystal band structure or scattering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维 Worley 距离场扰动光栅 LUT 坐标，模拟斑块变彩；不求解三维光子晶体的能带与散射"
          }
        }
      }
    },
    "effect.opal.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧泊"
          }
        }
      }
    },
    "effect.opal.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small patches of color flash within an opal-like surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋白石里二氧化硅微球密堆积形成三维光子晶体，闪烁的斑块状变色"
          }
        }
      }
    },
    "effect.opal.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opal Play of Color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧泊变彩（Opal, Play-of-Color）"
          }
        }
      }
    },
    "effect.parallaxNebula.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four Compute-generated layers shift at fixed depths and composite from back to front. Parallax and occlusion are bounded; there is no screen-space postprocessing or complete volumetric scattering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四层 Compute 生成的纹理按固定深度偏移并从后向前合成；使用有界视差和亮度遮挡，无屏幕后期，也不是完整体积散射"
          }
        }
      }
    },
    "effect.parallaxNebula.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parallax Nebula"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视差星云"
          }
        }
      }
    },
    "effect.parallaxNebula.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clouds and stars at different depths shift as the viewpoint moves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多层彩云与星点随着视点移动产生深度"
          }
        }
      }
    },
    "effect.parallaxNebula.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layered Parallax Nebula"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视差星云"
          }
        }
      }
    },
    "effect.pearl.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nacre LUT is reused with thickness offset, a |N·V| curvature hue sweep, body tint and a separate highlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复用珍珠母 LUT：厚度偏置 + |N·V|×曲率项（中心到边缘色相渐变）+ 体色叠加 + 高光"
          }
        }
      }
    },
    "effect.pearl.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pearl"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "珍珠"
          }
        }
      }
    },
    "effect.pearl.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directional luster and a rose-gold body gradient sweep across a pearl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正圆珍珠的多层定向珠光 + 表面曲率驱动的体色渐变（粉白-金）"
          }
        }
      }
    },
    "effect.pearl.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultured Pearl"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正圆珍珠（Cultured Pearl）"
          }
        }
      }
    },
    "effect.pleochroism.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB absorption along three orthogonal crystal axes is weighted by squared view components and attenuated by Beer-Lambert law. Polarization splitting and facet refraction are omitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个正交晶轴的 RGB 吸收系数按视线方向平方加权，经 Beer–Lambert 衰减；未模拟偏振分束及宝石切面折射"
          }
        }
      }
    },
    "effect.pleochroism.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleochroism"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多色性"
          }
        }
      }
    },
    "effect.pleochroism.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body colors differ along different crystal viewing axes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿晶体不同方向观察呈现不同体色"
          }
        }
      }
    },
    "effect.pleochroism.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crystal Pleochroism"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多色性"
          }
        }
      }
    },
    "effect.rainbow.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An 81-wavelength angular LUT uses the stationary deviation angles of dispersive drops. Gaussian width and approximate intensity replace full Mie scattering; moving the view or light direction changes the bow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用色散水滴的驻定偏向角生成 81 波长角度 LUT；主虹和副虹采用高斯展宽及近似强度，非完整 Mie 散射。移动视点或调整光源才能改变虹带位置"
          }
        }
      }
    },
    "effect.rainbow.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double Rainbow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雨虹与双虹"
          }
        }
      }
    },
    "effect.rainbow.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A primary bow and reversed-color secondary bow appear opposite the sun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反太阳方向出现主虹及颜色反转的副虹"
          }
        }
      }
    },
    "effect.rainbow.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary and Secondary Rainbows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雨虹与双虹"
          }
        }
      }
    },
    "effect.retroreflective.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A narrow return lobe based on light/view angle is multiplied by incident cosine. This shows angular retroreflection without tracing beads or corner cubes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光源与视线夹角的窄回归瓣乘入射余弦；展示逆反射角响应，不追踪微珠或角锥中的光路"
          }
        }
      }
    },
    "effect.retroreflective.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroreflection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逆反射材料"
          }
        }
      }
    },
    "effect.retroreflective.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The material brightens when the light is near the viewer's direction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光源靠近观察方向时突然明亮"
          }
        }
      }
    },
    "effect.retroreflective.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroreflective Material"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逆反射材料"
          }
        }
      }
    },
    "effect.scarab.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two equivalent film thicknesses are blended linearly by the R-to-L control. This illustrates color branches, not actual circular-polarization selection or analyzer-angle response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个等效薄膜厚度采样，由 R→L 滑杆线性混合；这是偏振色支示意，不代表真实圆偏振选择反射或检偏器角度响应"
          }
        }
      }
    },
    "effect.scarab.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polarized Scarab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆偏振金龟"
          }
        }
      }
    },
    "effect.scarab.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two color branches represent polarization-selective beetle reflections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分金龟子的螺旋层状结构选择反射圆偏振光；此处展示两支颜色的混合示意"
          }
        }
      }
    },
    "effect.scarab.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circular-Polarization Scarab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆偏振金龟子（Circular-Polarization Scarab）"
          }
        }
      }
    },
    "effect.speckle.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View displacement in object space shifts 3D cell noise; a threshold forms grains without spherical-UV pole distortion. This is a speckle appearance, not coherent wave-field interference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体空间视线偏移三维坐标，cellnoise 加阈值模拟颗粒并避免球面 UV 极点拉伸；这是散斑外观近似，不计算相干波场叠加"
          }
        }
      }
    },
    "effect.speckle.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laser Speckle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激光散斑"
          }
        }
      }
    },
    "effect.speckle.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine granular contrast on a rough surface moves with the viewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相干光照在粗糙表面上的细密颗粒状明暗图样，随观察者移动而流动"
          }
        }
      }
    },
    "effect.speckle.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laser Speckle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激光散斑（Laser Speckle）"
          }
        }
      }
    },
    "effect.starGem.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cat's-eye template combines three highlight bands separated by 60°. It does not trace repeated refraction inside a gemstone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享猫眼模板，叠加三组相差 60° 的定向亮带；不追踪宝石内部多次折射"
          }
        }
      }
    },
    "effect.starGem.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star Gem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "星光宝石"
          }
        }
      }
    },
    "effect.starGem.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three inclusion directions form a six-rayed moving star."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三组定向包裹体形成六射星光"
          }
        }
      }
    },
    "effect.starGem.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star Sapphire Asterism"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "星光宝石"
          }
        }
      }
    },
    "effect.sunstone.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Object-space cells place random inclusions; platelet orientation and a half-vector control each glint. There is no volumetric ray tracing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体空间细胞随机包裹体，随机片层朝向与半角矢量控制闪点；无体积光线追踪"
          }
        }
      }
    },
    "effect.sunstone.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunstone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日光石"
          }
        }
      }
    },
    "effect.sunstone.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copper-gold platelet glints flash with light and view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铜金色片状闪点随光源与视角闪烁"
          }
        }
      }
    },
    "effect.sunstone.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunstone Aventurescence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日光石"
          }
        }
      }
    },
    "effect.thinFilm.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nonabsorbing, nondispersive three-medium Fresnel and Airy spectrum is integrated under CIE 1931/D65 into linear RGB. Thickness is averaged over a Gaussian distribution."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无吸收、无色散的三介质 Fresnel + Airy 光谱积分；CIE 1931 / D65 转线性 RGB，膜厚按高斯分布平均"
          }
        }
      }
    },
    "effect.thinFilm.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thin Film"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "薄膜干涉"
          }
        }
      }
    },
    "effect.thinFilm.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow bands on soap bubbles and oil films change with thickness and angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肥皂泡/油膜的彩虹色，随膜厚与视角变化（已实现）"
          }
        }
      }
    },
    "effect.thinFilm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thin-Film Interference · Soap Bubble"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "薄膜干涉 · 肥皂泡（Thin-Film Interference）"
          }
        }
      }
    },
    "effect.titanium.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A film model uses air, an n=2.4 oxide and an absorbing metal with complex index 2.7+3.3i. These representative constants cannot predict voltage or real swatches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气／折射率 2.4 氧化层／复折射率 2.7+3.3i 金属基底的薄膜模型；常数 n、k 是代表性近似，不用于预测电压或真实色卡"
          }
        }
      }
    },
