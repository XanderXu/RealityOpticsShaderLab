    "effect.chameleon.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Random phase in Worley crystal domains and time-driven grating-LUT hue sampling approximate color changes, with brightness texture modulation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "worley 晶域随机相位 + time 驱动循环采样光栅 LUT 色相轴，皮肤纹理亮度扰动"
          }
        }
      }
    },
    "effect.chameleon.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chameleon Skin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
