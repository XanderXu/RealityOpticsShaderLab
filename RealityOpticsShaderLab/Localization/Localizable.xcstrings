          }
        }
      }
    },
    "effect.catEye.mechanism": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An object-space fiber axis controls an anisotropic angular lobe driven by normal/half-vector deviation. It approximates directional reflections from inclusions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体空间纤维方向控制各向异性角度瓣；以法线和半角矢量的偏差驱动窄亮带，属于包裹体定向反射的外观近似"
          }
        }
      }
    },
    "effect.catEye.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat's Eye"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "猫眼效应"
          }
        }
      }
    },
    "effect.catEye.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A narrow highlight sweeps over parallel fibers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平行纤维产生随视角扫动的窄亮带"
          }
        }
      }
    },
    "effect.catEye.title": {
