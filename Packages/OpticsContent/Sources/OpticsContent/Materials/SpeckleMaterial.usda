#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "SpeckleMaterial"
    {
        float inputs:SpeckScale = 220
        float inputs:Flow = 0.35
        float inputs:Threshold = 0.82
        float inputs:Gain = 1.6
        float inputs:Intensity = 1
        token outputs:mtlx:surface.connect = </Root/SpeckleMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/SpeckleMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/SpeckleMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "Position"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "PositionUnit"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/SpeckleMaterial/Position.outputs:out>
            float inputs:in2 = 0.22
            float3 outputs:out
        }

        def Shader "ViewFlow"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/SpeckleMaterial/ViewDir.outputs:out>
            float inputs:in2.connect = </Root/SpeckleMaterial.inputs:Flow>
            float3 outputs:out
        }

        def Shader "FlowPosition"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/SpeckleMaterial/PositionUnit.outputs:out>
            float3 inputs:in2.connect = </Root/SpeckleMaterial/ViewFlow.outputs:out>
            float3 outputs:out
        }

        def Shader "GrainPosition"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/SpeckleMaterial/FlowPosition.outputs:out>
            float inputs:in2.connect = </Root/SpeckleMaterial.inputs:SpeckScale>
            float3 outputs:out
        }

        def Shader "GrainRand"
        {
            uniform token info:id = "ND_cellnoise3d_float"
            float3 inputs:position.connect = </Root/SpeckleMaterial/GrainPosition.outputs:out>
            float outputs:out
        }

        def Shader "High"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/SpeckleMaterial.inputs:Threshold>
            float inputs:in2 = 0.95
            float outputs:out
        }

        def Shader "Sparkle"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/SpeckleMaterial/GrainRand.outputs:out>
            float inputs:low.connect = </Root/SpeckleMaterial.inputs:Threshold>
            float inputs:high.connect = </Root/SpeckleMaterial/ThresholdHigh.outputs:out>
            float outputs:out
        }

        def Shader "LaserColor"
        {
            uniform token info:id = "ND_constant_color3"
            color3f inputs:value = (0.35, 1, 0.45)
            color3f outputs:out
        }

        def Shader "Beam"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/SpeckleMaterial/LaserColor.outputs:out>
            float inputs:in2.connect = </Root/SpeckleMaterial/Sparkle.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/SpeckleMaterial/Beam.outputs:out>
            float inputs:in2.connect = </Root/SpeckleMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.5, 0.5, 0.5) (
                colorSpace = "srgb_texture"
            )
            color3f inputs:fg.connect = </Root/SpeckleMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/SpeckleMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/SpeckleMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "ThresholdHigh"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/SpeckleMaterial/High.outputs:out>
            float inputs:in2 = 0.05
            float outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/SpeckleMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }
    }
}
