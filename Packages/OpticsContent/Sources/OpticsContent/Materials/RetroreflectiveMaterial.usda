#usda 1.0
(defaultPrim = "Root")
def Xform "Root"
{
    def Material "RetroreflectiveMaterial"
    {
        float inputs:LightAngle = 0
        float inputs:Sharpness = 160
        float inputs:Gain = 1
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/RetroreflectiveMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/RetroreflectiveMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "NormalSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/NormalSource.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/NormalSource.outputs:out>
            float outputs:out
        }

        def Shader "NormalSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/NormalSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "NormalLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/NormalSafe.outputs:out>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/NormalSource.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/NormalLength.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "ViewSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/ViewSource.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/ViewSource.outputs:out>
            float outputs:out
        }

        def Shader "ViewSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/ViewSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "ViewLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/ViewSafe.outputs:out>
            float outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/ViewSource.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/ViewLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "NV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/AbsNV.outputs:out>
            float inputs:low = 0.002
            float inputs:high = 1
            float outputs:out
        }

        def Shader "FaceSign"
        {
            uniform token info:id = "ND_ifgreater_float"
            float inputs:value1.connect = </Root/RetroreflectiveMaterial/NdotV.outputs:out>
            float inputs:value2 = 0.0
            float inputs:in1 = 1.0
            float inputs:in2 = -1.0
            float outputs:out
        }

        def Shader "FacingNormal"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/Normal.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/FaceSign.outputs:out>
            float3 outputs:out
        }

        def Shader "LightRadians"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial.inputs:LightAngle>
            float inputs:in2 = 0.01745329252
            float outputs:out
        }

        def Shader "LightX"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/LightRadians.outputs:out>
            float outputs:out
        }

        def Shader "LightZ"
        {
            uniform token info:id = "ND_cos_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/LightRadians.outputs:out>
            float outputs:out
        }

        def Shader "WorldLight"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/LightX.outputs:out>
            float inputs:in2 = 0.0
            float inputs:in3.connect = </Root/RetroreflectiveMaterial/LightZ.outputs:out>
            float3 outputs:out
        }

        def Shader "ObjectLight"
        {
            uniform token info:id = "ND_transformvector_vector3"
            float3 inputs:in.connect = </Root/RetroreflectiveMaterial/WorldLight.outputs:out>
            string inputs:fromspace = "world"
            string inputs:tospace = "object"
            float3 outputs:out
        }

        def Shader "LightSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/ObjectLight.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/ObjectLight.outputs:out>
            float outputs:out
        }

        def Shader "LightSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/LightSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "LightLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/LightSafe.outputs:out>
            float outputs:out
        }

        def Shader "Light"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/ObjectLight.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/LightLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NLRaw"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/FacingNormal.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/Light.outputs:out>
            float outputs:out
        }

        def Shader "NL"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/NLRaw.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LightView"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/RetroreflectiveMaterial/Light.outputs:out>
            float3 inputs:in2.connect = </Root/RetroreflectiveMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "Alignment"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/RetroreflectiveMaterial/LightView.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Cone"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/Alignment.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial.inputs:Sharpness>
            float outputs:out
        }

        def Shader "BodyFacing"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/NV.outputs:out>
            float inputs:in2 = 0.55
            float outputs:out
        }

        def Shader "BodyShade"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/BodyFacing.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "Body"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (0.04, 0.045, 0.05)
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/BodyShade.outputs:out>
            color3f outputs:out
        }

        def Shader "Return"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/Cone.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/NL.outputs:out>
            float outputs:out
        }

        def Shader "ReturnGain"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/RetroreflectiveMaterial/Return.outputs:out>
            float inputs:in2 = 3.0
            float outputs:out
        }

        def Shader "ReturnColor"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (0.85, 0.94, 1.0)
            float inputs:in2.connect = </Root/RetroreflectiveMaterial/ReturnGain.outputs:out>
            color3f outputs:out
        }

        def Shader "Final"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/RetroreflectiveMaterial/Body.outputs:out>
            color3f inputs:in2.connect = </Root/RetroreflectiveMaterial/ReturnColor.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/RetroreflectiveMaterial/Final.outputs:out>
            float inputs:in2.connect = </Root/RetroreflectiveMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "BaseColorBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/RetroreflectiveMaterial/GainMul.outputs:out>
            color3f inputs:fg.connect = </Root/RetroreflectiveMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/RetroreflectiveMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/RetroreflectiveMaterial.inputs:BaseColor>
            color3f inputs:fg.connect = </Root/RetroreflectiveMaterial/BaseColorBlend.outputs:out>
            float inputs:mix.connect = </Root/RetroreflectiveMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/RetroreflectiveMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/RetroreflectiveMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1.0
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "DefaultSurfaceShader" (active = false)
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }
    }
}
