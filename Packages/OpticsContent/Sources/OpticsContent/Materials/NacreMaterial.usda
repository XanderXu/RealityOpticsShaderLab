#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "NacreMaterial"
    {
        asset inputs:NacreLUT
        float inputs:ThicknessScale = 0.55
        float inputs:ThicknessBias = 0.25
        float inputs:NoiseAmount = 0.08
        float inputs:Gain = 1.4
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/NacreMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/NacreMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/NacreMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/NacreMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/NacreMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/NacreMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "ClampNV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/NacreMaterial/AbsNV.outputs:out>
            float inputs:low = 0.02
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/NacreMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "OneMinusV"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/NacreMaterial/SepUV.outputs:outy>
            float outputs:out
        }

        def Shader "BaseThick"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/NacreMaterial/OneMinusV.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial.inputs:ThicknessScale>
            float outputs:out
        }

        def Shader "BiasThick"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/NacreMaterial/BaseThick.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial.inputs:ThicknessBias>
            float outputs:out
        }

        def Shader "UVtoV3"
        {
            uniform token info:id = "ND_convert_vector2_vector3"
            float2 inputs:in.connect = </Root/NacreMaterial/Texcoord.outputs:out>
            float3 outputs:out
        }

        def Shader "Fractal"
        {
            uniform token info:id = "ND_fractal3d_color3"
            float3 inputs:position.connect = </Root/NacreMaterial/UVtoV3.outputs:out>
            float3 inputs:amplitude = (0.5, 0.5, 0.5)
            int inputs:octaves = 4
            color3f outputs:out
        }

        def Shader "SepNoise"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/NacreMaterial/Fractal.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "NoiseMul"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/NacreMaterial/SepNoise.outputs:outr>
            float inputs:in2.connect = </Root/NacreMaterial.inputs:NoiseAmount>
            float outputs:out
        }

        def Shader "ThickSum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/NacreMaterial/BiasThick.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/NoiseMul.outputs:out>
            float outputs:out
        }

        def Shader "ThickClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/NacreMaterial/ThickSum.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LutUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/NacreMaterial/ClampNV.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/ThickClamp.outputs:out>
            float2 outputs:out
        }

        def Shader "NacreImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/NacreMaterial.inputs:NacreLUT>
            float2 inputs:texcoord.connect = </Root/NacreMaterial/LutUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/NacreMaterial/SubstrateReplaced.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial.inputs:Gain>
            color3f outputs:out
        }

        # Display comparison of a colored base and the optical signal, in linear light.
        # BaseAmount = 0 preserves the original effect; 1 isolates the base color.

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/NacreMaterial/SubstrateIntensityBase.outputs:out>
            color3f inputs:fg.connect = </Root/NacreMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/NacreMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/NacreMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/NacreMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/NacreMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "SubstratePositive"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/NacreMaterial/NacreImage.outputs:out>
            color3f inputs:in2 = (0.0, 0.0, 0.0)
            color3f outputs:out
        }

        def Shader "SubstrateNeutralChannels"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/NacreMaterial/SubstratePositive.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "SubstrateNeutralMinRG"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMin"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMinRG.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateNeutralMaxRG"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMaxRG.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateChroma"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralMin.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateSafeMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2 = 0.0001
            float outputs:out
        }

        def Shader "SubstrateSaturation"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateChroma.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateSafeMax.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateColoredMask"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/NacreMaterial/SubstrateSaturation.outputs:out>
            float inputs:low = 0.04
            float inputs:high = 0.4
            float outputs:out
        }

        def Shader "SubstrateNeutralMask"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1.0
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateColoredMask.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateDarkBody"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMask.outputs:out>
            float inputs:in2 = 0.35
            float outputs:out
        }

        def Shader "SubstrateBodyLevel"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/NacreMaterial/SubstrateNeutralMin.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateDarkBody.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateTintedBody"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/NacreMaterial.inputs:BaseColor>
            float inputs:in2.connect = </Root/NacreMaterial/SubstrateBodyLevel.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateNeutralRGB"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/NacreMaterial/SubstrateNeutralMin.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateBodyDelta"
        {
            uniform token info:id = "ND_subtract_color3"
            color3f inputs:in1.connect = </Root/NacreMaterial/SubstrateTintedBody.outputs:out>
            color3f inputs:in2.connect = </Root/NacreMaterial/SubstrateNeutralRGB.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateWeightedDelta"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/NacreMaterial/SubstrateBodyDelta.outputs:out>
            float inputs:in2.connect = </Root/NacreMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "SubstrateReplaced"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/NacreMaterial/NacreImage.outputs:out>
            color3f inputs:in2.connect = </Root/NacreMaterial/SubstrateWeightedDelta.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateIntensityBase"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.2140411405, 0.2140411405, 0.2140411405)
            color3f inputs:fg.connect = </Root/NacreMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/NacreMaterial.inputs:BaseAmount>
            color3f outputs:out
        }
    }
}
