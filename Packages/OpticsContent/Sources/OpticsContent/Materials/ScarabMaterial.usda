#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "ScarabMaterial"
    {
        asset inputs:ScarabLUT
        float inputs:ThicknessBias = 0.22
        float inputs:BranchShift = 0.12
        float inputs:Analyzer = 0
        float inputs:Gain = 1.8
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/ScarabMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/ScarabMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/ScarabMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/ScarabMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/ScarabMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/ScarabMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/ScarabMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "UClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/ScarabMaterial/AbsNV.outputs:out>
            float inputs:low = 0.05
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "UVtoV3"
        {
            uniform token info:id = "ND_convert_vector2_vector3"
            float2 inputs:in.connect = </Root/ScarabMaterial/Texcoord.outputs:out>
            float3 outputs:out
        }

        def Shader "Fractal"
        {
            uniform token info:id = "ND_fractal3d_color3"
            float3 inputs:position.connect = </Root/ScarabMaterial/UVtoV3.outputs:out>
            float3 inputs:amplitude = (0.5, 0.5, 0.5)
            int inputs:octaves = 3
            color3f outputs:out
        }

        def Shader "SepNoise"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/ScarabMaterial/Fractal.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "Thirty"
        {
            uniform token info:id = "ND_constant_float"
            float inputs:value = 0.03
            float outputs:out
        }

        def Shader "NoiseMul"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SepNoise.outputs:outr>
            float inputs:in2.connect = </Root/ScarabMaterial/Thirty.outputs:out>
            float outputs:out
        }

        def Shader "V1"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/ScarabMaterial.inputs:ThicknessBias>
            float inputs:in2.connect = </Root/ScarabMaterial/NoiseMul.outputs:out>
            float outputs:out
        }

        def Shader "V1Clamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/ScarabMaterial/V1.outputs:out>
            float inputs:low = 0
            float inputs:high = 0.85
            float outputs:out
        }

        def Shader "V2"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/ScarabMaterial/V1Clamp.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial.inputs:BranchShift>
            float outputs:out
        }

        def Shader "V2Clamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/ScarabMaterial/V2.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LutUVA"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/ScarabMaterial/UClamp.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/V1Clamp.outputs:out>
            float2 outputs:out
        }

        def Shader "LutUVB"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/ScarabMaterial/UClamp.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/V2Clamp.outputs:out>
            float2 outputs:out
        }

        def Shader "ImageLCP"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/ScarabMaterial.inputs:ScarabLUT>
            float2 inputs:texcoord.connect = </Root/ScarabMaterial/LutUVA.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "ImageRCP"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/ScarabMaterial.inputs:ScarabLUT>
            float2 inputs:texcoord.connect = </Root/ScarabMaterial/LutUVB.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "PolMix"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/ScarabMaterial/ImageRCP.outputs:out>
            color3f inputs:fg.connect = </Root/ScarabMaterial/ImageLCP.outputs:out>
            float inputs:mix.connect = </Root/ScarabMaterial.inputs:Analyzer>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/ScarabMaterial/SubstrateReplaced.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial.inputs:Gain>
            color3f outputs:out
        }

        # Display comparison of a colored base and the optical signal, in linear light.
        # BaseAmount = 0 preserves the original effect; 1 isolates the base color.

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/ScarabMaterial/SubstrateIntensityBase.outputs:out>
            color3f inputs:fg.connect = </Root/ScarabMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/ScarabMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/ScarabMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/ScarabMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "SubstratePositive"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/ScarabMaterial/PolMix.outputs:out>
            color3f inputs:in2 = (0.0, 0.0, 0.0)
            color3f outputs:out
        }

        def Shader "SubstrateNeutralChannels"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/ScarabMaterial/SubstratePositive.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "SubstrateNeutralMinRG"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMin"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMinRG.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateNeutralMaxRG"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMaxRG.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateChroma"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralMin.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateSafeMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2 = 0.0001
            float outputs:out
        }

        def Shader "SubstrateSaturation"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateChroma.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateSafeMax.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateColoredMask"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/ScarabMaterial/SubstrateSaturation.outputs:out>
            float inputs:low = 0.04
            float inputs:high = 0.4
            float outputs:out
        }

        def Shader "SubstrateNeutralMask"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1.0
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateColoredMask.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateDarkBody"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMask.outputs:out>
            float inputs:in2 = 0.35
            float outputs:out
        }

        def Shader "SubstrateBodyLevel"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/ScarabMaterial/SubstrateNeutralMin.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateDarkBody.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateTintedBody"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/ScarabMaterial.inputs:BaseColor>
            float inputs:in2.connect = </Root/ScarabMaterial/SubstrateBodyLevel.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateNeutralRGB"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/ScarabMaterial/SubstrateNeutralMin.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateBodyDelta"
        {
            uniform token info:id = "ND_subtract_color3"
            color3f inputs:in1.connect = </Root/ScarabMaterial/SubstrateTintedBody.outputs:out>
            color3f inputs:in2.connect = </Root/ScarabMaterial/SubstrateNeutralRGB.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateWeightedDelta"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/ScarabMaterial/SubstrateBodyDelta.outputs:out>
            float inputs:in2.connect = </Root/ScarabMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "SubstrateReplaced"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/ScarabMaterial/PolMix.outputs:out>
            color3f inputs:in2.connect = </Root/ScarabMaterial/SubstrateWeightedDelta.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateIntensityBase"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.2140411405, 0.2140411405, 0.2140411405)
            color3f inputs:fg.connect = </Root/ScarabMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/ScarabMaterial.inputs:BaseAmount>
            color3f outputs:out
        }
    }
}
