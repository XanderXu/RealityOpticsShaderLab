#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "BeetleMaterial"
    {
        asset inputs:FilmLUT
        asset inputs:RainbowLUT
        float inputs:GreenBand = 0.22
        float inputs:RainbowMix = 0.35
        float inputs:Gain = 1.8
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/BeetleMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/BeetleMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/BeetleMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/BeetleMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BeetleMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/BeetleMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/BeetleMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "ClampNV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/BeetleMaterial/AbsNV.outputs:out>
            float inputs:low = 0.02
            float inputs:high = 1
            float outputs:out
        }

        def Shader "GreenUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/BeetleMaterial/ClampNV.outputs:out>
            float inputs:in2.connect = </Root/BeetleMaterial.inputs:GreenBand>
            float2 outputs:out
        }

        def Shader "GreenImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/BeetleMaterial.inputs:FilmLUT>
            float2 inputs:texcoord.connect = </Root/BeetleMaterial/GreenUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "Radial"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/BeetleMaterial/GrooveAxis.outputs:out>
            float inputs:in2.connect = </Root/BeetleMaterial/RadialLength.outputs:out>
            float3 outputs:out
        }

        def Shader "VoP"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BeetleMaterial/ViewDir.outputs:out>
            float3 inputs:in2.connect = </Root/BeetleMaterial/Radial.outputs:out>
            float outputs:out
        }

        def Shader "DeltaQuarter"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BeetleMaterial/VoP.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "UClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/BeetleMaterial/U01.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/BeetleMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "RainbowUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/BeetleMaterial/UClamp.outputs:out>
            float inputs:in2.connect = </Root/BeetleMaterial/SepUV.outputs:outy>
            float2 outputs:out
        }

        def Shader "RainbowImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/BeetleMaterial.inputs:RainbowLUT>
            float2 inputs:texcoord.connect = </Root/BeetleMaterial/RainbowUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "RainbowMixNode"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/BeetleMaterial/GreenImage.outputs:out>
            color3f inputs:fg.connect = </Root/BeetleMaterial/RainbowImage.outputs:out>
            float inputs:mix.connect = </Root/BeetleMaterial.inputs:RainbowMix>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/BeetleMaterial/RainbowMixNode.outputs:out>
            float inputs:in2.connect = </Root/BeetleMaterial.inputs:Gain>
            color3f outputs:out
        }

        # Display comparison of a colored base and the optical signal, in linear light.
        # BaseAmount = 0 preserves the original effect; 1 isolates the base color.
        def Shader "BaseColorBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/BeetleMaterial/GainMul.outputs:out>
            color3f inputs:fg.connect = </Root/BeetleMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/BeetleMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/BeetleMaterial.inputs:BaseColor>
            color3f inputs:fg.connect = </Root/BeetleMaterial/BaseColorBlend.outputs:out>
            float inputs:mix.connect = </Root/BeetleMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/BeetleMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "GrooveAxis"
        {
            uniform token info:id = "ND_bitangent_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "RadialLength2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BeetleMaterial/GrooveAxis.outputs:out>
            float3 inputs:in2.connect = </Root/BeetleMaterial/GrooveAxis.outputs:out>
            float outputs:out
        }

        def Shader "RadialSafeLength2"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BeetleMaterial/RadialLength2.outputs:out>
            float inputs:in2 = 1e-08
            float outputs:out
        }

        def Shader "RadialLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/BeetleMaterial/RadialSafeLength2.outputs:out>
            float outputs:out
        }

        def Shader "U01"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/BeetleMaterial/DeltaQuarter.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/BeetleMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }
    }
}
