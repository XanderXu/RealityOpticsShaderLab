#usda 1.0
(defaultPrim = "Root")
def Xform "Root"
{
    def Material "LabradoriteMaterial"
    {
        float inputs:Spacing = 190
        float inputs:DomainScale = 6
        float inputs:Sharpness = 12
        float inputs:LightAngle = 18
        float inputs:Gain = 1
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        asset inputs:FilmLUT
        token outputs:mtlx:surface.connect = </Root/LabradoriteMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/LabradoriteMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "NormalSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/NormalSource.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/NormalSource.outputs:out>
            float outputs:out
        }

        def Shader "NormalSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/NormalSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "NormalLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/NormalSafe.outputs:out>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/NormalSource.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/NormalLength.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "ViewSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/ViewSource.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/ViewSource.outputs:out>
            float outputs:out
        }

        def Shader "ViewSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/ViewSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "ViewLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/ViewSafe.outputs:out>
            float outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/ViewSource.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/ViewLength.outputs:out>
            float3 outputs:out
        }

        def Shader "Position"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "UnitPosition"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/Position.outputs:out>
            float inputs:in2 = 0.12
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "NV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/AbsNV.outputs:out>
            float inputs:low = 0.002
            float inputs:high = 1
            float outputs:out
        }

        def Shader "FaceSign"
        {
            uniform token info:id = "ND_ifgreater_float"
            float inputs:value1.connect = </Root/LabradoriteMaterial/NdotV.outputs:out>
            float inputs:value2 = 0.0
            float inputs:in1 = 1.0
            float inputs:in2 = -1.0
            float outputs:out
        }

        def Shader "FacingNormal"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/Normal.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/FaceSign.outputs:out>
            float3 outputs:out
        }

        def Shader "LightRadians"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial.inputs:LightAngle>
            float inputs:in2 = 0.01745329252
            float outputs:out
        }

        def Shader "LightX"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/LightRadians.outputs:out>
            float outputs:out
        }

        def Shader "LightZ"
        {
            uniform token info:id = "ND_cos_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/LightRadians.outputs:out>
            float outputs:out
        }

        def Shader "WorldLight"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/LabradoriteMaterial/LightX.outputs:out>
            float inputs:in2 = 0.0
            float inputs:in3.connect = </Root/LabradoriteMaterial/LightZ.outputs:out>
            float3 outputs:out
        }

        def Shader "ObjectLight"
        {
            uniform token info:id = "ND_transformvector_vector3"
            float3 inputs:in.connect = </Root/LabradoriteMaterial/WorldLight.outputs:out>
            string inputs:fromspace = "world"
            string inputs:tospace = "object"
            float3 outputs:out
        }

        def Shader "LightSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/ObjectLight.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/ObjectLight.outputs:out>
            float outputs:out
        }

        def Shader "LightSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/LightSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "LightLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/LightSafe.outputs:out>
            float outputs:out
        }

        def Shader "Light"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/ObjectLight.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/LightLength.outputs:out>
            float3 outputs:out
        }

        def Shader "HalfSum"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/Light.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/View.outputs:out>
            float3 outputs:out
        }

        def Shader "HalfSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/HalfSum.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/HalfSum.outputs:out>
            float outputs:out
        }

        def Shader "HalfSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/HalfSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "HalfLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/HalfSafe.outputs:out>
            float outputs:out
        }

        def Shader "Half"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/HalfSum.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/HalfLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NLRaw"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/FacingNormal.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/Light.outputs:out>
            float outputs:out
        }

        def Shader "NL"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/NLRaw.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "NHRaw"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/FacingNormal.outputs:out>
            float3 inputs:in2.connect = </Root/LabradoriteMaterial/Half.outputs:out>
            float outputs:out
        }

        def Shader "NH"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/NHRaw.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "DomainPosition"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/LabradoriteMaterial/UnitPosition.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial.inputs:DomainScale>
            float3 outputs:out
        }

        def Shader "DomainField"
        {
            uniform token info:id = "ND_fractal3d_color3"
            float3 inputs:position.connect = </Root/LabradoriteMaterial/DomainPosition.outputs:out>
            float3 inputs:amplitude = (0.5, 0.5, 0.5)
            int inputs:octaves = 2
            color3f outputs:out
        }

        def Shader "DomainSeparate"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/LabradoriteMaterial/DomainField.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "DomainBias"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/DomainSeparate.outputs:outr>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "Domain"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/DomainBias.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LayerVariation"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/Domain.outputs:out>
            float inputs:in2 = 45.0
            float outputs:out
        }

        def Shader "ThicknessNoise"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial.inputs:Spacing>
            float inputs:in2.connect = </Root/LabradoriteMaterial/LayerVariation.outputs:out>
            float outputs:out
        }

        def Shader "LayerThickness"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/ThicknessNoise.outputs:out>
            float inputs:in2 = 1200.0
            float outputs:out
        }

        def Shader "FilmUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/LabradoriteMaterial/NV.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/LayerThickness.outputs:out>
            float2 outputs:out
        }

        def Shader "Film"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/LabradoriteMaterial.inputs:FilmLUT>
            float2 inputs:texcoord.connect = </Root/LabradoriteMaterial/FilmUV.outputs:out>
            color3f inputs:default = (0, 0, 0)
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "Flash"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/NH.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial.inputs:Sharpness>
            float outputs:out
        }

        def Shader "LitFlash"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/Flash.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/NL.outputs:out>
            float outputs:out
        }

        def Shader "DomainMask"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/LabradoriteMaterial/Domain.outputs:out>
            float inputs:low = 0.12
            float inputs:high = 0.75
            float outputs:out
        }

        def Shader "DomainFlash"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/LitFlash.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/DomainMask.outputs:out>
            float outputs:out
        }

        def Shader "BodyFacing"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/NV.outputs:out>
            float inputs:in2 = 0.55
            float outputs:out
        }

        def Shader "BodyShade"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/BodyFacing.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "Body"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (0.016, 0.025, 0.026)
            float inputs:in2.connect = </Root/LabradoriteMaterial/BodyShade.outputs:out>
            color3f outputs:out
        }

        def Shader "FlashGain"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LabradoriteMaterial/DomainFlash.outputs:out>
            float inputs:in2 = 4.0
            float outputs:out
        }

        def Shader "FlashColor"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/LabradoriteMaterial/Film.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial/FlashGain.outputs:out>
            color3f outputs:out
        }

        def Shader "Final"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/LabradoriteMaterial/Body.outputs:out>
            color3f inputs:in2.connect = </Root/LabradoriteMaterial/FlashColor.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/LabradoriteMaterial/Final.outputs:out>
            float inputs:in2.connect = </Root/LabradoriteMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "BaseColorBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/LabradoriteMaterial/GainMul.outputs:out>
            color3f inputs:fg.connect = </Root/LabradoriteMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/LabradoriteMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/LabradoriteMaterial.inputs:BaseColor>
            color3f inputs:fg.connect = </Root/LabradoriteMaterial/BaseColorBlend.outputs:out>
            float inputs:mix.connect = </Root/LabradoriteMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/LabradoriteMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/LabradoriteMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1.0
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "DefaultSurfaceShader" (active = false)
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }
    }
}
