        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/AbsorbingGlassMaterial/SurfaceReflectionU.outputs:out>
            float inputs:in2.connect = </Root/AbsorbingGlassMaterial/SurfaceReflectionV.outputs:out>
            float2 outputs:out
        }

        def Shader "SurfaceReflection"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/AbsorbingGlassMaterial.inputs:Environment>
            float2 inputs:texcoord.connect = </Root/AbsorbingGlassMaterial/SurfaceReflectionUV.outputs:out>
            color3f inputs:default = (0, 0, 0)
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "Glass"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/AbsorbingGlassMaterial/ColoredTransmission.outputs:out>
            color3f inputs:fg.connect = </Root/AbsorbingGlassMaterial/SurfaceReflection.outputs:out>
            float inputs:mix.connect = </Root/AbsorbingGlassMaterial/Fresnel.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/AbsorbingGlassMaterial/Glass.outputs:out>
            float inputs:in2.connect = </Root/AbsorbingGlassMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "BaseColorBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/AbsorbingGlassMaterial/GainMul.outputs:out>
            color3f inputs:fg.connect = </Root/AbsorbingGlassMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/AbsorbingGlassMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/AbsorbingGlassMaterial.inputs:BaseColor>
            color3f inputs:fg.connect = </Root/AbsorbingGlassMaterial/BaseColorBlend.outputs:out>
            float inputs:mix.connect = </Root/AbsorbingGlassMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/AbsorbingGlassMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/AbsorbingGlassMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1.0
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "DefaultSurfaceShader" (active = false)
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }
    }
}
