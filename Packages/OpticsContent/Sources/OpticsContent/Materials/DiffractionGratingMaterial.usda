#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "DiffractionGratingMaterial"
    {
        asset inputs:GratingLUT
        float3 inputs:LightDirection = (-0.35, 0.75, 0.55)
        float inputs:DensityScale = 0.45
        float inputs:DensityBias = 0.25
        float inputs:Gain = 1.6
        float inputs:Intensity = 1
        float inputs:Opacity = 1.0
        token outputs:mtlx:surface.connect = </Root/DiffractionGratingMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/DiffractionGratingMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/DiffractionGratingMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "Radial"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/GrooveAxis.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial/RadialLength.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/DiffractionGratingMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "LightN"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/DiffractionGratingMaterial.inputs:LightDirection>
            float3 outputs:out
        }

        def Shader "VoP"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/ViewDir.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/Radial.outputs:out>
            float outputs:out
        }

        def Shader "LoP"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/LightN.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/Radial.outputs:out>
            float outputs:out
        }

        def Shader "Delta"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/LoP.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial/VoP.outputs:out>
            float outputs:out
        }

        def Shader "DeltaQuarter"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/Delta.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "U01"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/DeltaQuarter.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "UClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/U01.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/DiffractionGratingMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "RadScaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/SepUV.outputs:outy>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial.inputs:DensityScale>
            float outputs:out
        }

        def Shader "RadBias"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/RadScaled.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial.inputs:DensityBias>
            float outputs:out
        }

        def Shader "VClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/RadBias.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LutUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/UClamp.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial/VClamp.outputs:out>
            float2 outputs:out
        }

        def Shader "GratingImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/DiffractionGratingMaterial.inputs:GratingLUT>
            float2 inputs:texcoord.connect = </Root/DiffractionGratingMaterial/LutUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "HV"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/ViewDir.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/LightN.outputs:out>
            float3 outputs:out
        }

        def Shader "HN"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/HV.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial/HNLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotH"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/HN.outputs:out>
            float outputs:out
        }

        def Shader "NdotHC"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/AbsNH.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Spec"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/NdotHC.outputs:out>
            float inputs:in2 = 18
            float outputs:out
        }

        def Shader "Weighted"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/DiffractionGratingMaterial/GratingImage.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial/Illumination.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/DiffractionGratingMaterial/Reflected.outputs:out>
            float inputs:in2.connect = </Root/DiffractionGratingMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.5, 0.5, 0.5) (
                colorSpace = "srgb_texture"
            )
            color3f inputs:fg.connect = </Root/DiffractionGratingMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/DiffractionGratingMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/DiffractionGratingMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "GrooveAxis"
        {
            uniform token info:id = "ND_bitangent_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "RadialLength2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/GrooveAxis.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/GrooveAxis.outputs:out>
            float outputs:out
        }

        def Shader "RadialSafeLength2"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/RadialLength2.outputs:out>
            float inputs:in2 = 1e-08
            float outputs:out
        }

        def Shader "RadialLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/RadialSafeLength2.outputs:out>
            float outputs:out
        }

        def Shader "HNLength2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/HV.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/HV.outputs:out>
            float outputs:out
        }

        def Shader "HNSafeLength2"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/HNLength2.outputs:out>
            float inputs:in2 = 1e-08
            float outputs:out
        }

        def Shader "HNLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/HNSafeLength2.outputs:out>
            float outputs:out
        }

        def Shader "AbsNH"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/NdotH.outputs:out>
            float outputs:out
        }

        def Shader "NdotL"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/DiffractionGratingMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/DiffractionGratingMaterial/LightN.outputs:out>
            float outputs:out
        }

        def Shader "Illumination"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/NdotL.outputs:out>
            float outputs:out
        }

        def Shader "ZeroOrder"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/DiffractionGratingMaterial/Spec.outputs:out>
            float inputs:in2 = 0.08
            float outputs:out
        }

        def Shader "ZeroOrderColor"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/DiffractionGratingMaterial/ZeroOrder.outputs:out>
            color3f outputs:out
        }

        def Shader "Reflected"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/DiffractionGratingMaterial/Weighted.outputs:out>
            color3f inputs:in2.connect = </Root/DiffractionGratingMaterial/ZeroOrderColor.outputs:out>
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/DiffractionGratingMaterial/IntensityClamp.outputs:out>
            float inputs:opacity.connect = </Root/DiffractionGratingMaterial.inputs:Opacity>
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }
    }
}
