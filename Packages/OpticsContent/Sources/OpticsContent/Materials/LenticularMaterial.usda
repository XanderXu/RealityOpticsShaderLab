            float outputs:out
        }

        def Shader "ViewDomainEdgeMask"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainEdgeU.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewDomainEdgeV.outputs:out>
            float outputs:out
        }

        def Shader "ViewDomainUClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LenticularMaterial/SurfaceU.outputs:out>
            float inputs:low = 0.001953125
            float inputs:high = 0.998046875
            float outputs:out
        }

        def Shader "ViewDomainUTile"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainUClamp.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "ViewDomainVClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LenticularMaterial/SurfaceV.outputs:out>
            float inputs:low = 0.001953125
            float inputs:high = 0.998046875
            float outputs:out
        }

        def Shader "ViewDomainVTile"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainVClamp.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "ViewLowerHalfIndex"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LowerIndex.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "ViewLowerRowIndex"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Root/LenticularMaterial/ViewLowerHalfIndex.outputs:out>
            float outputs:out
        }

        def Shader "ViewLowerTwiceRow"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewLowerRowIndex.outputs:out>
            float inputs:in2 = 2.0
            float outputs:out
        }

        def Shader "ViewLowerColumnIndex"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LowerIndex.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewLowerTwiceRow.outputs:out>
            float outputs:out
        }

        def Shader "ViewLowerColumn"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewLowerColumnIndex.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
