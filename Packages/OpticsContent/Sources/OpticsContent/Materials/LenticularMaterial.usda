        }

        def Shader "LensPhase"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LensCoordinate.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/LensPhaseFloor.outputs:out>
            float outputs:out
        }

        def Shader "ViewAngle"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SlopeX.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial.inputs:ViewSpread>
            float outputs:out
        }

        def Shader "ViewOffset"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1 = 1.25
            float inputs:in2.connect = </Root/LenticularMaterial/ViewAngle.outputs:out>
            float outputs:out
        }

        def Shader "ViewIndex"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LenticularMaterial/ViewOffset.outputs:out>
            float inputs:low = 0
            float inputs:high = 3
            float outputs:out
        }

        def Shader "CenteredPhase"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LensPhase.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "LensWarp"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/CenteredPhase.outputs:out>
            float inputs:in2 = 0.22
            float outputs:out
        }

        def Shader "LensViewOffset"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewIndex.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/LensWarp.outputs:out>
            float outputs:out
        }

        def Shader "LensView"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LenticularMaterial/LensViewOffset.outputs:out>
            float inputs:low = 0
            float inputs:high = 3
            float outputs:out
        }

        def Shader "IndexFloor"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Root/LenticularMaterial/LensView.outputs:out>
            float outputs:out
        }

        def Shader "LowerIndex"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/LenticularMaterial/IndexFloor.outputs:out>
            float inputs:low = 0.0
            float inputs:high = 2.0
            float outputs:out
        }

        def Shader "UpperIndex"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LowerIndex.outputs:out>
            float inputs:in2 = 1.0
            float outputs:out
        }

        def Shader "TransitionCenter"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/LowerIndex.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "HalfBlend"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial.inputs:BlendWidth>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "BlendLow"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/LenticularMaterial/TransitionCenter.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/HalfBlend.outputs:out>
            float outputs:out
        }

        def Shader "BlendHigh"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/TransitionCenter.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/HalfBlend.outputs:out>
            float outputs:out
        }

        def Shader "ViewBlend"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/LenticularMaterial/LensView.outputs:out>
            float inputs:low.connect = </Root/LenticularMaterial/BlendLow.outputs:out>
            float inputs:high.connect = </Root/LenticularMaterial/BlendHigh.outputs:out>
            float outputs:out
        }

        def Shader "ViewDomainLeft"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/LenticularMaterial/SurfaceU.outputs:out>
            float inputs:low = 0.0
            float inputs:high = 0.05
            float outputs:out
        }

        def Shader "ViewDomainRemainingU"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1.0
            float inputs:in2.connect = </Root/LenticularMaterial/SurfaceU.outputs:out>
            float outputs:out
        }

        def Shader "ViewDomainRight"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/LenticularMaterial/ViewDomainRemainingU.outputs:out>
            float inputs:low = 0.0
            float inputs:high = 0.05
            float outputs:out
        }

        def Shader "ViewDomainEdgeU"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainLeft.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewDomainRight.outputs:out>
            float outputs:out
        }

        def Shader "ViewDomainBottom"
        {
            uniform token info:id = "ND_smoothstep_float"
