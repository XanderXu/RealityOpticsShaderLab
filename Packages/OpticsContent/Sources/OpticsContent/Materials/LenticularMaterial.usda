        }

        def Shader "ViewUpperUOffset"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainUTile.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewUpperColumn.outputs:out>
            float outputs:out
        }

        def Shader "ViewUpperVOffset"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainVTile.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewUpperRow.outputs:out>
            float outputs:out
        }

        def Shader "ViewUpperUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewUpperUOffset.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewUpperVOffset.outputs:out>
            float2 outputs:out
        }

        def Shader "ViewUpper"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/LenticularMaterial.inputs:Views>
            float2 inputs:texcoord.connect = </Root/LenticularMaterial/ViewUpperUV.outputs:out>
            color3f inputs:default = (0, 0, 0)
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
