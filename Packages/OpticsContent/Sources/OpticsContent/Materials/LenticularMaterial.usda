        def Shader "ViewUpperFaded"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/LenticularMaterial/ViewUpper.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewDomainEdgeMask.outputs:out>
            color3f outputs:out
        }

        def Shader "SelectedView"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/LenticularMaterial/ViewLowerFaded.outputs:out>
            color3f inputs:fg.connect = </Root/LenticularMaterial/ViewUpperFaded.outputs:out>
            float inputs:mix.connect = </Root/LenticularMaterial/ViewBlend.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/LenticularMaterial/SubstrateReplaced.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial.inputs:Gain>
