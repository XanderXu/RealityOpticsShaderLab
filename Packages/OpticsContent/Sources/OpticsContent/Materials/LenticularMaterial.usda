        }

        def Shader "SubstrateSaturation"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SubstrateChroma.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/SubstrateSafeMax.outputs:out>
