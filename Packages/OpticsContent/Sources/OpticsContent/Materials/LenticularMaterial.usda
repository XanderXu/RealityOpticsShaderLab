        }

        def Shader "ViewLowerUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewLowerUOffset.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewLowerVOffset.outputs:out>
            float2 outputs:out
        }

        def Shader "ViewLower"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/LenticularMaterial.inputs:Views>
            float2 inputs:texcoord.connect = </Root/LenticularMaterial/ViewLowerUV.outputs:out>
            color3f inputs:default = (0, 0, 0)
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "ViewLowerFaded"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/LenticularMaterial/ViewLower.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewDomainEdgeMask.outputs:out>
