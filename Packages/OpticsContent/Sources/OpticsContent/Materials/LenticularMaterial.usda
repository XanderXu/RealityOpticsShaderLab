        }

        def Shader "SubstrateNeutralMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SubstrateNeutralMaxRG.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateChroma"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/SubstrateNeutralMin.outputs:out>
