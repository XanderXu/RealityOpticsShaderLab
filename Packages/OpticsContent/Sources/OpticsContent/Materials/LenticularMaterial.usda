        }

        def Shader "ViewDomainTop"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/LenticularMaterial/ViewDomainRemainingV.outputs:out>
            float inputs:low = 0.0
            float inputs:high = 0.05
            float outputs:out
        }

        def Shader "ViewDomainEdgeV"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainBottom.outputs:out>
