            float outputs:out
        }

        def Shader "ViewUpperRow"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewUpperRowIndex.outputs:out>
            float inputs:in2 = 0.5
