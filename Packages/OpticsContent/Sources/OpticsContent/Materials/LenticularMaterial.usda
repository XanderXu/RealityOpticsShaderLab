#usda 1.0
(defaultPrim = "Root")
def Xform "Root"
{
    def Material "LenticularMaterial"
    {
        float inputs:ViewSpread = 1
        float inputs:LensPitch = 42
        float inputs:BlendWidth = 0.22
        float inputs:Gain = 1.2
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        asset inputs:Views
        token outputs:mtlx:surface.connect = </Root/LenticularMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/LenticularMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "ViewSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "ViewSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LenticularMaterial/ViewSource.outputs:out>
            float3 inputs:in2.connect = </Root/LenticularMaterial/ViewSource.outputs:out>
            float outputs:out
        }

        def Shader "ViewSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "ViewLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/LenticularMaterial/ViewSafe.outputs:out>
            float outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LenticularMaterial/ViewSource.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewLength.outputs:out>
            float3 outputs:out
        }

        def Shader "Position"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "UnitPosition"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/LenticularMaterial/Position.outputs:out>
            float inputs:in2 = 0.12
            float3 outputs:out
        }

        def Shader "SurfaceX"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LenticularMaterial/UnitPosition.outputs:out>
            float3 inputs:in2 = (1.0, 0.0, 0.0)
            float outputs:out
        }

        def Shader "SurfaceY"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LenticularMaterial/UnitPosition.outputs:out>
            float3 inputs:in2 = (0.0, 1.0, 0.0)
            float outputs:out
        }

        def Shader "UScale"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SurfaceX.outputs:out>
            float inputs:in2 = 0.45
            float outputs:out
        }

        def Shader "SurfaceU"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/UScale.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "VScale"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SurfaceY.outputs:out>
            float inputs:in2 = 0.45
            float outputs:out
        }

        def Shader "SurfaceV"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/VScale.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "ObserverX"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LenticularMaterial/View.outputs:out>
            float3 inputs:in2 = (1.0, 0.0, 0.0)
            float outputs:out
        }

        def Shader "ObserverZ"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/LenticularMaterial/View.outputs:out>
            float3 inputs:in2 = (0.0, 0.0, 1.0)
            float outputs:out
        }

        def Shader "AbsViewZ"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/LenticularMaterial/ObserverZ.outputs:out>
            float outputs:out
        }

        def Shader "ParallaxDenominator"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/LenticularMaterial/AbsViewZ.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "SlopeX"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ObserverX.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ParallaxDenominator.outputs:out>
            float outputs:out
        }

        def Shader "LensCoordinate"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/SurfaceU.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial.inputs:LensPitch>
            float outputs:out
        }

        def Shader "LensPhaseFloor"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Root/LenticularMaterial/LensCoordinate.outputs:out>
