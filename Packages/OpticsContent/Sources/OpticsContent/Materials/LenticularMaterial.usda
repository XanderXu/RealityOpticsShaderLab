        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/LenticularMaterial/SubstrateIntensityBase.outputs:out>
            color3f inputs:fg.connect = </Root/LenticularMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/LenticularMaterial.inputs:Intensity>
