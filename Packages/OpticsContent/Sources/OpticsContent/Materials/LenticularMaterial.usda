        def Shader "ViewLowerRow"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewLowerRowIndex.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "ViewLowerUOffset"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/LenticularMaterial/ViewDomainUTile.outputs:out>
            float inputs:in2.connect = </Root/LenticularMaterial/ViewLowerColumn.outputs:out>
