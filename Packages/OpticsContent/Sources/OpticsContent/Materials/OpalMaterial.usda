#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "OpalMaterial"
    {
        asset inputs:OpalLUT
        float inputs:CellScale = 6
        float inputs:Jitter = 0.5
        float inputs:DensityScale = 0.35
        float inputs:DensityBias = 0.2
        float inputs:Gain = 1.5
        float inputs:Intensity = 1
        token outputs:mtlx:surface.connect = </Root/OpalMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/OpalMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normal_vector3"
            float3 outputs:out
        }

        def Shader "Up"
        {
            uniform token info:id = "ND_constant_vector3"
            float3 inputs:value = (0, 1, 0)
            float3 outputs:out
        }

        def Shader "kDot"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/OpalMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/OpalMaterial/Up.outputs:out>
            float outputs:out
        }

        def Shader "kUp"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/OpalMaterial/Up.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial/kDot.outputs:out>
            float3 outputs:out
        }

        def Shader "RadialV"
        {
            uniform token info:id = "ND_subtract_vector3"
            float3 inputs:in1.connect = </Root/OpalMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/OpalMaterial/kUp.outputs:out>
            float3 outputs:out
        }

        def Shader "Radial"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/OpalMaterial/RadialV.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            float3 outputs:out
        }

        def Shader "VoP"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/OpalMaterial/ViewDir.outputs:out>
            float3 inputs:in2.connect = </Root/OpalMaterial/Radial.outputs:out>
            float outputs:out
        }

        def Shader "DeltaQuarter"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/OpalMaterial/VoP.outputs:out>
            float inputs:in2 = 0.25
            float outputs:out
        }

        def Shader "U01"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/OpalMaterial/DeltaQuarter.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "WorleyUV"
        {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </Root/OpalMaterial/Texcoord.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:CellScale>
            float2 outputs:out
        }

        def Shader "WorleyRand"
        {
            uniform token info:id = "ND_worleynoise2d_float"
            float2 inputs:texcoord.connect = </Root/OpalMaterial/WorleyUV.outputs:out>
            float inputs:jitter = 1
            float outputs:out
        }

        def Shader "RandC"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/OpalMaterial/WorleyRand.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "RandScaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/OpalMaterial/RandC.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:Jitter>
            float outputs:out
        }

        def Shader "UJittered"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/OpalMaterial/U01.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial/RandScaled.outputs:out>
            float outputs:out
        }

        def Shader "UClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/OpalMaterial/UJittered.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/OpalMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "RadScaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/OpalMaterial/SepUV.outputs:outy>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:DensityScale>
            float outputs:out
        }

        def Shader "RadBias"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/OpalMaterial/RadScaled.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:DensityBias>
            float outputs:out
        }

        def Shader "VClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/OpalMaterial/RadBias.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LutUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/OpalMaterial/UClamp.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial/VClamp.outputs:out>
            float2 outputs:out
        }

        def Shader "OpalImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/OpalMaterial.inputs:OpalLUT>
            float2 inputs:texcoord.connect = </Root/OpalMaterial/LutUV.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/OpalMaterial/OpalImage.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "IntensityEff"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/OpalMaterial/GainMul.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "OneMinusI"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/OpalMaterial.inputs:Intensity>
            float outputs:out
        }

        def Shader "GrayC"
        {
            uniform token info:id = "ND_constant_color3"
            color3f inputs:value = (0.5, 0.5, 0.5) (
                colorSpace = "srgb_texture"
            )
            color3f outputs:out
        }

        def Shader "GrayTerm"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/OpalMaterial/GrayC.outputs:out>
            float inputs:in2.connect = </Root/OpalMaterial/OneMinusI.outputs:out>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/OpalMaterial/IntensityEff.outputs:out>
            color3f inputs:in2.connect = </Root/OpalMaterial/GrayTerm.outputs:out>
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/OpalMaterial/IntensityBlend.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }
    }
}
