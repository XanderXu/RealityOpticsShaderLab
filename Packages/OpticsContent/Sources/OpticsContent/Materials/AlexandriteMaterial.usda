#usda 1.0
(defaultPrim = "Root")
def Xform "Root"
{
    def Material "AlexandriteMaterial"
    {
        float inputs:Illuminant = 0
        float inputs:PathLength = 1
        float inputs:Gain = 1
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/AlexandriteMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/AlexandriteMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "NormalSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/AlexandriteMaterial/NormalSource.outputs:out>
            float3 inputs:in2.connect = </Root/AlexandriteMaterial/NormalSource.outputs:out>
            float outputs:out
        }

        def Shader "NormalSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/AlexandriteMaterial/NormalSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "NormalLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/AlexandriteMaterial/NormalSafe.outputs:out>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/AlexandriteMaterial/NormalSource.outputs:out>
            float inputs:in2.connect = </Root/AlexandriteMaterial/NormalLength.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "ViewSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/AlexandriteMaterial/ViewSource.outputs:out>
            float3 inputs:in2.connect = </Root/AlexandriteMaterial/ViewSource.outputs:out>
            float outputs:out
        }

        def Shader "ViewSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/AlexandriteMaterial/ViewSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "ViewLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/AlexandriteMaterial/ViewSafe.outputs:out>
            float outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/AlexandriteMaterial/ViewSource.outputs:out>
            float inputs:in2.connect = </Root/AlexandriteMaterial/ViewLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/AlexandriteMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/AlexandriteMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/AlexandriteMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "NV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/AlexandriteMaterial/AbsNV.outputs:out>
            float inputs:low = 0.002
            float inputs:high = 1
            float outputs:out
        }

        def Shader "IlluminantColor"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.055, 0.38, 0.16)
            color3f inputs:fg = (0.46, 0.035, 0.15)
            float inputs:mix.connect = </Root/AlexandriteMaterial.inputs:Illuminant>
            color3f outputs:out
        }

        def Shader "PathRGB"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/AlexandriteMaterial.inputs:PathLength>
            color3f outputs:out
        }

        def Shader "Absorption"
        {
            uniform token info:id = "ND_power_color3"
            color3f inputs:in1.connect = </Root/AlexandriteMaterial/IlluminantColor.outputs:out>
            color3f inputs:in2.connect = </Root/AlexandriteMaterial/PathRGB.outputs:out>
            color3f outputs:out
        }

        def Shader "Facing"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/AlexandriteMaterial/NV.outputs:out>
            float inputs:in2 = 0.65
            float outputs:out
        }

        def Shader "FacingShade"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1 = 0.35
            float inputs:in2.connect = </Root/AlexandriteMaterial/Facing.outputs:out>
            float outputs:out
        }

        def Shader "Final"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/AlexandriteMaterial/Absorption.outputs:out>
            float inputs:in2.connect = </Root/AlexandriteMaterial/FacingShade.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/AlexandriteMaterial/Final.outputs:out>
            float inputs:in2.connect = </Root/AlexandriteMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "BaseColorBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/AlexandriteMaterial/GainMul.outputs:out>
            color3f inputs:fg.connect = </Root/AlexandriteMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/AlexandriteMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/AlexandriteMaterial.inputs:BaseColor>
            color3f inputs:fg.connect = </Root/AlexandriteMaterial/BaseColorBlend.outputs:out>
            float inputs:mix.connect = </Root/AlexandriteMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/AlexandriteMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/AlexandriteMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1.0
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "DefaultSurfaceShader" (active = false)
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }
    }
}
