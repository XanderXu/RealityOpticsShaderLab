#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "BirefringenceMaterial"
    {
        asset inputs:PhaseLUT
        float inputs:PhaseScale = 2.0
        float inputs:NoiseAmount = 0.3
        float inputs:Gain = 1.3
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/BirefringenceMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/BirefringenceMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/BirefringenceMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "Grad"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SepUV.outputs:outx>
            float inputs:in2.connect = </Root/BirefringenceMaterial.inputs:PhaseScale>
            float outputs:out
        }

        def Shader "UVtoV3"
        {
            uniform token info:id = "ND_convert_vector2_vector3"
            float2 inputs:in.connect = </Root/BirefringenceMaterial/Texcoord.outputs:out>
            float3 outputs:out
        }

        def Shader "Fractal"
        {
            uniform token info:id = "ND_fractal3d_color3"
            float3 inputs:position.connect = </Root/BirefringenceMaterial/UVtoV3.outputs:out>
            float3 inputs:amplitude = (0.5, 0.5, 0.5)
            int inputs:octaves = 4
            color3f outputs:out
        }

        def Shader "SepNoise"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/BirefringenceMaterial/Fractal.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "NoiseMul"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SepNoise.outputs:outr>
            float inputs:in2.connect = </Root/BirefringenceMaterial.inputs:NoiseAmount>
            float outputs:out
        }

        def Shader "PhaseSum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/Grad.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/NoiseMul.outputs:out>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/BirefringenceMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/BirefringenceMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "ClampNV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/AbsNV.outputs:out>
            float inputs:low = 0.3
            float inputs:high = 1
            float outputs:out
        }

        def Shader "PhaseView"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/PhaseSum.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/ClampNV.outputs:out>
            float outputs:out
        }

        def Shader "Half"
        {
            uniform token info:id = "ND_constant_float"
            float inputs:value = 0.5
            float outputs:out
        }

        def Shader "LutUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/BirefringenceMaterial/PhaseClamp.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/Half.outputs:out>
            float2 outputs:out
        }

        def Shader "PhaseImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/BirefringenceMaterial.inputs:PhaseLUT>
            float2 inputs:texcoord.connect = </Root/BirefringenceMaterial/LutUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "Polarizer"
        {
            uniform token info:id = "ND_constant_vector3"
            float3 inputs:value = (0.70710678, 0.70710678, 0)
            float3 outputs:out
        }

        def Shader "Stress"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/StressProjected.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/StressLength.outputs:out>
            float3 outputs:out
        }

        def Shader "dS"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/Stress.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/AnalyzerAxis.outputs:out>
            float outputs:out
        }

        def Shader "dSq"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/dS.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/dS.outputs:out>
            float outputs:out
        }

        def Shader "TwoSq"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/dSq.outputs:out>
            float inputs:in2 = 2
            float outputs:out
        }

        def Shader "Cos2a"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/TwoSq.outputs:out>
            float inputs:in2 = 1
            float outputs:out
        }

        def Shader "Cos2aSq"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/Cos2a.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/Cos2a.outputs:out>
            float outputs:out
        }

        def Shader "Sin2aSq"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/BirefringenceMaterial/Cos2aSq.outputs:out>
            float outputs:out
        }

        def Shader "Extinction"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/Sin2aSq.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateReplaced.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "ExtMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/GainMul.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/Extinction.outputs:out>
            color3f outputs:out
        }

        # Display comparison of a colored base and the optical signal, in linear light.
        # BaseAmount = 0 preserves the original effect; 1 isolates the base color.

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/BirefringenceMaterial/SubstrateIntensityBase.outputs:out>
            color3f inputs:fg.connect = </Root/BirefringenceMaterial/ExtMul.outputs:out>
            float inputs:mix.connect = </Root/BirefringenceMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "StressAxis"
        {
            uniform token info:id = "ND_transformvector_vector3"
            float3 inputs:in = (1, 0, 0)
            string inputs:fromspace = "object"
            string inputs:tospace = "world"
            float3 outputs:out
        }

        def Shader "StressAlongView"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/StressAxis.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "StressViewPart"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/ViewDir.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/StressAlongView.outputs:out>
            float3 outputs:out
        }

        def Shader "StressProjected"
        {
            uniform token info:id = "ND_subtract_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/StressAxis.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/StressViewPart.outputs:out>
            float3 outputs:out
        }

        def Shader "StressLength2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/StressProjected.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/StressProjected.outputs:out>
            float outputs:out
        }

        def Shader "StressSafeLength2"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/StressLength2.outputs:out>
            float inputs:in2 = 1e-08
            float outputs:out
        }

        def Shader "StressLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/StressSafeLength2.outputs:out>
            float outputs:out
        }

        def Shader "AnalyzerAxisAlongView"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/Polarizer.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "AnalyzerAxisViewPart"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/ViewDir.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/AnalyzerAxisAlongView.outputs:out>
            float3 outputs:out
        }

        def Shader "AnalyzerAxisProjected"
        {
            uniform token info:id = "ND_subtract_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/Polarizer.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/AnalyzerAxisViewPart.outputs:out>
            float3 outputs:out
        }

        def Shader "AnalyzerAxisLength2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/AnalyzerAxisProjected.outputs:out>
            float3 inputs:in2.connect = </Root/BirefringenceMaterial/AnalyzerAxisProjected.outputs:out>
            float outputs:out
        }

        def Shader "AnalyzerAxisSafeLength2"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/AnalyzerAxisLength2.outputs:out>
            float inputs:in2 = 1e-08
            float outputs:out
        }

        def Shader "AnalyzerAxisLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/AnalyzerAxisSafeLength2.outputs:out>
            float outputs:out
        }

        def Shader "AnalyzerAxis"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/BirefringenceMaterial/AnalyzerAxisProjected.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/AnalyzerAxisLength.outputs:out>
            float3 outputs:out
        }

        def Shader "PhaseU"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/PhaseView.outputs:out>
            float inputs:in2 = 20
            float outputs:out
        }

        def Shader "PhaseClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/PhaseU.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/BirefringenceMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "SubstratePositive"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/PhaseImage.outputs:out>
            color3f inputs:in2 = (0.0, 0.0, 0.0)
            color3f outputs:out
        }

        def Shader "SubstrateNeutralChannels"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/BirefringenceMaterial/SubstratePositive.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "SubstrateNeutralMinRG"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMin"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMinRG.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateNeutralMaxRG"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMaxRG.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateChroma"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralMin.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateSafeMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2 = 0.0001
            float outputs:out
        }

        def Shader "SubstrateSaturation"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateChroma.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateSafeMax.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateColoredMask"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/BirefringenceMaterial/SubstrateSaturation.outputs:out>
            float inputs:low = 0.04
            float inputs:high = 0.4
            float outputs:out
        }

        def Shader "SubstrateNeutralMask"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1.0
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateColoredMask.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateDarkBody"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMask.outputs:out>
            float inputs:in2 = 0.35
            float outputs:out
        }

        def Shader "SubstrateBodyLevel"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateNeutralMin.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateDarkBody.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateTintedBody"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial.inputs:BaseColor>
            float inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateBodyLevel.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateNeutralRGB"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/BirefringenceMaterial/SubstrateNeutralMin.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateBodyDelta"
        {
            uniform token info:id = "ND_subtract_color3"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateTintedBody.outputs:out>
            color3f inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateNeutralRGB.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateWeightedDelta"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/SubstrateBodyDelta.outputs:out>
            float inputs:in2.connect = </Root/BirefringenceMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "SubstrateReplaced"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/BirefringenceMaterial/PhaseImage.outputs:out>
            color3f inputs:in2.connect = </Root/BirefringenceMaterial/SubstrateWeightedDelta.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateIntensityBase"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.2140411405, 0.2140411405, 0.2140411405)
            color3f inputs:fg.connect = </Root/BirefringenceMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/BirefringenceMaterial.inputs:BaseAmount>
            color3f outputs:out
        }
    }
}
