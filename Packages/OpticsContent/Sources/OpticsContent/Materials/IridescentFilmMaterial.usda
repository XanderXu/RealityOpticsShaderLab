#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "IridescentFilmMaterial"
    {
        asset inputs:FilmLUT
        float inputs:ThicknessScale = 1.0
        float inputs:ThicknessBias = 0.15
        float inputs:NoiseAmount = 0.12
        float inputs:Gain = 2.2
        float inputs:Intensity = 1
        float inputs:Opacity = 0.92
        token outputs:mtlx:surface.connect = </Root/IridescentFilmMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/IridescentFilmMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/IridescentFilmMaterial/NormalSource.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewDir"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/IridescentFilmMaterial/ViewDirSource.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/IridescentFilmMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/IridescentFilmMaterial/ViewDir.outputs:out>
            float outputs:out
        }

        def Shader "ClampNV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/IridescentFilmMaterial/AbsNV.outputs:out>
            float inputs:low = 0.02
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "SepUV"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/IridescentFilmMaterial/Texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "OneMinusV"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/IridescentFilmMaterial/SepUV.outputs:outy>
            float outputs:out
        }

        def Shader "BaseThick"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/IridescentFilmMaterial/OneMinusV.outputs:out>
            float inputs:in2.connect = </Root/IridescentFilmMaterial.inputs:ThicknessScale>
            float outputs:out
        }

        def Shader "BiasThick"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/IridescentFilmMaterial/BaseThick.outputs:out>
            float inputs:in2.connect = </Root/IridescentFilmMaterial.inputs:ThicknessBias>
            float outputs:out
        }

        def Shader "UVtoV3"
        {
            uniform token info:id = "ND_convert_vector2_vector3"
            float2 inputs:in.connect = </Root/IridescentFilmMaterial/Texcoord.outputs:out>
            float3 outputs:out
        }

        def Shader "Fractal"
        {
            uniform token info:id = "ND_fractal3d_color3"
            float3 inputs:position.connect = </Root/IridescentFilmMaterial/UVtoV3.outputs:out>
            float3 inputs:amplitude = (0.5, 0.5, 0.5)
            int inputs:octaves = 4
            color3f outputs:out
        }

        def Shader "SepNoise"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/IridescentFilmMaterial/Fractal.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "NoiseMul"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/IridescentFilmMaterial/SepNoise.outputs:outr>
            float inputs:in2.connect = </Root/IridescentFilmMaterial.inputs:NoiseAmount>
            float outputs:out
        }

        def Shader "ThickSum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/IridescentFilmMaterial/BiasThick.outputs:out>
            float inputs:in2.connect = </Root/IridescentFilmMaterial/NoiseMul.outputs:out>
            float outputs:out
        }

        def Shader "ThickClamp"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/IridescentFilmMaterial/ThickSum.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "LutUV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/IridescentFilmMaterial/ClampNV.outputs:out>
            float inputs:in2.connect = </Root/IridescentFilmMaterial/ThickClamp.outputs:out>
            float2 outputs:out
        }

        def Shader "FilmImage"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (0, 0, 0)
            asset inputs:file.connect = </Root/IridescentFilmMaterial.inputs:FilmLUT>
            float2 inputs:texcoord.connect = </Root/IridescentFilmMaterial/LutUV.outputs:out>
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/IridescentFilmMaterial/FilmImage.outputs:out>
            float inputs:in2.connect = </Root/IridescentFilmMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.5, 0.5, 0.5) (
                colorSpace = "srgb_texture"
            )
            color3f inputs:fg.connect = </Root/IridescentFilmMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/IridescentFilmMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "ViewDirSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/IridescentFilmMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/IridescentFilmMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/IridescentFilmMaterial/IntensityClamp.outputs:out>
            float inputs:opacity.connect = </Root/IridescentFilmMaterial.inputs:Opacity>
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }
    }
}
