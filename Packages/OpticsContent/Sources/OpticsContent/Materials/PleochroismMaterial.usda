#usda 1.0
(defaultPrim = "Root")
def Xform "Root"
{
    def Material "PleochroismMaterial"
    {
        float inputs:PathLength = 1
        float inputs:AxisAngle = 0
        float inputs:AxisTilt = 0
        float inputs:Gain = 1
        float inputs:Intensity = 1
        color3f inputs:BaseColor = (0.2140411405, 0.2140411405, 0.2140411405)
        float inputs:BaseAmount = 0
        token outputs:mtlx:surface.connect = </Root/PleochroismMaterial/Unlit.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/PleochroismMaterial/DefaultSurfaceShader.outputs:surface>

        def Shader "NormalSource"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "NormalSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/NormalSource.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/NormalSource.outputs:out>
            float outputs:out
        }

        def Shader "NormalSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/NormalSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "NormalLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/PleochroismMaterial/NormalSafe.outputs:out>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/NormalSource.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/NormalLength.outputs:out>
            float3 outputs:out
        }

        def Shader "ViewSource"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "ViewSq"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/ViewSource.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/ViewSource.outputs:out>
            float outputs:out
        }

        def Shader "ViewSafe"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/ViewSq.outputs:out>
            float inputs:in2 = 1e-06
            float outputs:out
        }

        def Shader "ViewLength"
        {
            uniform token info:id = "ND_sqrt_float"
            float inputs:in.connect = </Root/PleochroismMaterial/ViewSafe.outputs:out>
            float outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_divide_vector3FA"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/ViewSource.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/ViewLength.outputs:out>
            float3 outputs:out
        }

        def Shader "NdotV"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AbsNV"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/PleochroismMaterial/NdotV.outputs:out>
            float outputs:out
        }

        def Shader "NV"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/PleochroismMaterial/AbsNV.outputs:out>
            float inputs:low = 0.002
            float inputs:high = 1
            float outputs:out
        }

        def Shader "AxisRadians"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial.inputs:AxisAngle>
            float inputs:in2 = 0.01745329252
            float outputs:out
        }

        def Shader "CosAxis"
        {
            uniform token info:id = "ND_cos_float"
            float inputs:in.connect = </Root/PleochroismMaterial/AxisRadians.outputs:out>
            float outputs:out
        }

        def Shader "SinAxis"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </Root/PleochroismMaterial/AxisRadians.outputs:out>
            float outputs:out
        }

        def Shader "TiltRadians"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial.inputs:AxisTilt>
            float inputs:in2 = 0.01745329252
            float outputs:out
        }

        def Shader "CosTilt"
        {
            uniform token info:id = "ND_cos_float"
            float inputs:in.connect = </Root/PleochroismMaterial/TiltRadians.outputs:out>
            float outputs:out
        }

        def Shader "SinTilt"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </Root/PleochroismMaterial/TiltRadians.outputs:out>
            float outputs:out
        }

        def Shader "CrystalX"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/PleochroismMaterial/CosAxis.outputs:out>
            float inputs:in2 = 0.0
            float inputs:in3.connect = </Root/PleochroismMaterial/SinAxis.outputs:out>
            float3 outputs:out
        }

        def Shader "NegativeSin"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SinAxis.outputs:out>
            float inputs:in2 = -1.0
            float outputs:out
        }

        def Shader "TiltX"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/NegativeSin.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SinTilt.outputs:out>
            float outputs:out
        }

        def Shader "TiltZ"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/CosAxis.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SinTilt.outputs:out>
            float outputs:out
        }

        def Shader "CrystalY"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/PleochroismMaterial/TiltX.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/CosTilt.outputs:out>
            float inputs:in3.connect = </Root/PleochroismMaterial/TiltZ.outputs:out>
            float3 outputs:out
        }

        def Shader "CrystalZ"
        {
            uniform token info:id = "ND_crossproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/CrystalX.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/CrystalY.outputs:out>
            float3 outputs:out
        }

        def Shader "AxisView0"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/CrystalX.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AxisWeight0"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/AxisView0.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisView0.outputs:out>
            float outputs:out
        }

        def Shader "Absorb0"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (2.2, 0.35, 1.4)
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisWeight0.outputs:out>
            color3f outputs:out
        }

        def Shader "AxisView1"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/CrystalY.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AxisWeight1"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/AxisView1.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisView1.outputs:out>
            float outputs:out
        }

        def Shader "Absorb1"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (0.35, 1.9, 1.1)
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisWeight1.outputs:out>
            color3f outputs:out
        }

        def Shader "AxisView2"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/PleochroismMaterial/CrystalZ.outputs:out>
            float3 inputs:in2.connect = </Root/PleochroismMaterial/View.outputs:out>
            float outputs:out
        }

        def Shader "AxisWeight2"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/AxisView2.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisView2.outputs:out>
            float outputs:out
        }

        def Shader "Absorb2"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1 = (1.8, 1.2, 0.22)
            float inputs:in2.connect = </Root/PleochroismMaterial/AxisWeight2.outputs:out>
            color3f outputs:out
        }

        def Shader "SigmaXY"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/Absorb0.outputs:out>
            color3f inputs:in2.connect = </Root/PleochroismMaterial/Absorb1.outputs:out>
            color3f outputs:out
        }

        def Shader "Sigma"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/SigmaXY.outputs:out>
            color3f inputs:in2.connect = </Root/PleochroismMaterial/Absorb2.outputs:out>
            color3f outputs:out
        }

        def Shader "NegativePath"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial.inputs:PathLength>
            float inputs:in2 = -1.0
            float outputs:out
        }

        def Shader "OpticalDepth"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/Sigma.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/NegativePath.outputs:out>
            color3f outputs:out
        }

        def Shader "DepthVector"
        {
            uniform token info:id = "ND_convert_color3_vector3"
            color3f inputs:in.connect = </Root/PleochroismMaterial/OpticalDepth.outputs:out>
            float3 outputs:out
        }

        def Shader "Attenuation"
        {
            uniform token info:id = "ND_exp_vector3"
            float3 inputs:in.connect = </Root/PleochroismMaterial/DepthVector.outputs:out>
            float3 outputs:out
        }

        def Shader "Transmission"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Root/PleochroismMaterial/Attenuation.outputs:out>
            color3f outputs:out
        }

        def Shader "Facing"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/NV.outputs:out>
            float inputs:in2 = 0.65
            float outputs:out
        }

        def Shader "FacingShade"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1 = 0.35
            float inputs:in2.connect = </Root/PleochroismMaterial/Facing.outputs:out>
            float outputs:out
        }

        def Shader "Final"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/SubstrateReplaced.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/FacingShade.outputs:out>
            color3f outputs:out
        }

        def Shader "GainMul"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/Final.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial.inputs:Gain>
            color3f outputs:out
        }

        def Shader "IntensityBlend"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg.connect = </Root/PleochroismMaterial/SubstrateIntensityBase.outputs:out>
            color3f inputs:fg.connect = </Root/PleochroismMaterial/GainMul.outputs:out>
            float inputs:mix.connect = </Root/PleochroismMaterial.inputs:Intensity>
            color3f outputs:out
        }

        def Shader "IntensityClamp"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/IntensityBlend.outputs:out>
            color3f inputs:in2 = (0, 0, 0)
            color3f outputs:out
        }

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/PleochroismMaterial/IntensityClamp.outputs:out>
            float inputs:opacity = 1.0
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "DefaultSurfaceShader" (active = false)
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "SubstratePositive"
        {
            uniform token info:id = "ND_max_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/Transmission.outputs:out>
            color3f inputs:in2 = (0.0, 0.0, 0.0)
            color3f outputs:out
        }

        def Shader "SubstrateNeutralChannels"
        {
            uniform token info:id = "ND_separate3_color3"
            color3f inputs:in.connect = </Root/PleochroismMaterial/SubstratePositive.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
        }

        def Shader "SubstrateNeutralMinRG"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMin"
        {
            uniform token info:id = "ND_min_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMinRG.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateNeutralMaxRG"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outr>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outg>
            float outputs:out
        }

        def Shader "SubstrateNeutralMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMaxRG.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralChannels.outputs:outb>
            float outputs:out
        }

        def Shader "SubstrateChroma"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralMin.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateSafeMax"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMax.outputs:out>
            float inputs:in2 = 0.0001
            float outputs:out
        }

        def Shader "SubstrateSaturation"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateChroma.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateSafeMax.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateColoredMask"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/PleochroismMaterial/SubstrateSaturation.outputs:out>
            float inputs:low = 0.04
            float inputs:high = 0.4
            float outputs:out
        }

        def Shader "SubstrateNeutralMask"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1.0
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateColoredMask.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateDarkBody"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMask.outputs:out>
            float inputs:in2 = 0.35
            float outputs:out
        }

        def Shader "SubstrateBodyLevel"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/PleochroismMaterial/SubstrateNeutralMin.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateDarkBody.outputs:out>
            float outputs:out
        }

        def Shader "SubstrateTintedBody"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/PleochroismMaterial.inputs:BaseColor>
            float inputs:in2.connect = </Root/PleochroismMaterial/SubstrateBodyLevel.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateNeutralRGB"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Root/PleochroismMaterial/SubstrateNeutralMin.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateBodyDelta"
        {
            uniform token info:id = "ND_subtract_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/SubstrateTintedBody.outputs:out>
            color3f inputs:in2.connect = </Root/PleochroismMaterial/SubstrateNeutralRGB.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateWeightedDelta"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/SubstrateBodyDelta.outputs:out>
            float inputs:in2.connect = </Root/PleochroismMaterial.inputs:BaseAmount>
            color3f outputs:out
        }

        def Shader "SubstrateReplaced"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1.connect = </Root/PleochroismMaterial/Transmission.outputs:out>
            color3f inputs:in2.connect = </Root/PleochroismMaterial/SubstrateWeightedDelta.outputs:out>
            color3f outputs:out
        }

        def Shader "SubstrateIntensityBase"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.2140411405, 0.2140411405, 0.2140411405)
            color3f inputs:fg.connect = </Root/PleochroismMaterial.inputs:BaseColor>
            float inputs:mix.connect = </Root/PleochroismMaterial.inputs:BaseAmount>
            color3f outputs:out
        }
    }
}
